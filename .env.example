POSTGRES_PASSWORD=replace-with-a-local-random-url-safe-password
API_PORT=8002
WEB_PORT=8082
WORKBENCH_ALLOWED_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://127.0.0.1:4174","http://127.0.0.1:8082"]
# Set to the verified reverse-proxy peer, never a wildcard.
FORWARDED_ALLOW_IPS=127.0.0.1
# Live analysis requires mode=openrouter and that provider’s call enablement.
# Keep the API key in an ignored .env; Compose passes it only to the worker.
WORKBENCH_PROVIDER_MODE=deterministic
WORKBENCH_OPENROUTER_MODEL=openai/gpt-4.1-mini
WORKBENCH_OPENROUTER_CALLS_ENABLED=false
WORKBENCH_OPENROUTER_API_KEY=
WORKBENCH_OPENROUTER_MAX_TOKENS=800
# Lifetime attempt reservations, including failed calls.
# Optional explicit unlimited removes the cumulative ceiling; usage still counts.
WORKBENCH_LIVE_CALL_BUDGET=3
