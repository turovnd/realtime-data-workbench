{
  "name": "feedback-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter realtime-data-workbench-ui dev",
    "build": "pnpm --filter realtime-data-workbench-ui build",
    "typecheck": "pnpm --filter realtime-data-workbench-ui typecheck:app && tsc -p tsconfig.tests.json",
    "lint": "eslint web tests/web *.ts --max-warnings 0",
    "format": "prettier --write web tests/web package.json pnpm-workspace.yaml *.ts *.js tsconfig.tests.json",
    "format:check": "prettier --check web tests/web package.json pnpm-workspace.yaml *.ts *.js tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=mobile",
    "test:connected": "PLAYWRIGHT_CONNECTED=1 playwright test --project=connected"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
