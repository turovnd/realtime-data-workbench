WORKBENCH_OPENROUTER_CALLS_ENABLED=false
WORKBENCH_OPENROUTER_API_KEY=
WORKBENCH_OPENROUTER_MAX_TOKENS=800
WORKBENCH_LIVE_CALL_BUDGET=3
